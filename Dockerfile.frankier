# Frankier's image: the shared base image plus a current Neovim.
#
# The base image is built and pushed by .github/workflows/build-base-image.yml.
# This file only extends it, and .github/workflows/build-frankier-image.yml
# rebuilds the result whenever the base image is rebuilt, passing the exact base
# tag through BASE_IMAGE.
ARG BASE_IMAGE=ghcr.io/frankier/robotools:latest
FROM ${BASE_IMAGE}

# Neovim's upstream tarball instead of Debian's `neovim` package: bookworm ships
# 0.7.x, while the tarball is the current release. The tarball is used rather
# than the AppImage because it needs no FUSE. Bump NEOVIM_VERSION to upgrade.
ARG NEOVIM_VERSION=v0.12.6
ARG TARGETARCH

USER root

RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
        amd64) nvim_arch=x86_64 ;; \
        arm64) nvim_arch=arm64 ;; \
        *) echo "error: unsupported architecture '${TARGETARCH}'" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/nvim.tar.gz \
        "https://github.com/neovim/neovim/releases/download/${NEOVIM_VERSION}/nvim-linux-${nvim_arch}.tar.gz"; \
    tar -xzf /tmp/nvim.tar.gz -C /opt; \
    rm /tmp/nvim.tar.gz; \
    ln -sf "/opt/nvim-linux-${nvim_arch}/bin/nvim" /usr/local/bin/nvim; \
    nvim --version
